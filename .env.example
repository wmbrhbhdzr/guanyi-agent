# ============================================================
# 环境变量模板
# 使用方法：复制本文件为 .env，填入真实值。
#   Copy-Item .env.example .env
# .env 已被 .gitignore 忽略，严禁提交到版本库。
# 本文件只含占位符，可以安全入库。
# ============================================================

# 运行时决策模型（具备视觉能力）
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 调用名说明：
#   使用 deepseek-flash 作为调用名。
#   旧名称 deepseek-v4-flash / deepseek-v4-flash-vision-exp 为别名，
#   实际由 DeepSeek-V4.1-Flash 提供服务，按 Flash 价格计费。

# 计费单价（元 / 百万 token），用于成本估算脚本
PRICE_INPUT_CACHED_OFFPEAK=0.02
PRICE_INPUT_CACHED_PEAK=0.04
PRICE_INPUT_MISS_OFFPEAK=1
PRICE_INPUT_MISS_PEAK=2
PRICE_OUTPUT_OFFPEAK=4
PRICE_OUTPUT_PEAK=8
